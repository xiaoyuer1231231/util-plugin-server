<config>
    <input>
        <jar in="../quality.jar" out="../quality.jar"/>
    </input>

    <keep-names>
        <class access="private+">
            <field access="private+"/>
            <method access="private+"/>
        </class>
    </keep-names>

    <watermark key="WWW.DTDREAM.COM" value="CopyRight (c)"/>
    <property name="random-seed" value="WWW.DTDREAM.COM"/>

    <property name="local-variables-naming" value="keep-parameters"/>

    <property name="line-numbers" value="keep"/>
    <property name="synthetize-methods" value="disable"/>
    <property name="synthetize-fields" value="disable"/>

    <ignore-classes>
        <class template="class org.springframework.*"/>
        <class template="class org.apache.*"/>
    </ignore-classes>
</config>